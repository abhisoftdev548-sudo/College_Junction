# Browser → API base. Leave empty to use the same-origin /api proxy (dev).
# For split-origin deploys: NEXT_PUBLIC_API_URL=https://api.collegejunction.com
NEXT_PUBLIC_API_URL=
# Server-side rewrite target for /api/* when NEXT_PUBLIC_API_URL is empty.
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
