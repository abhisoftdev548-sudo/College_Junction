# ── Deployment mode ─────────────────────────────────────────────────────────
# DEFAULT (recommended): leave NEXT_PUBLIC_API_URL empty. The browser talks to
# /api/* on this host and Next.js proxies requests to API_INTERNAL_URL — auth
# cookies stay first-party (SameSite=Lax), no CORS involved.
NEXT_PUBLIC_API_URL=
# Server-side target of the /api/* proxy.
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: bypass the proxy for FILE UPLOADS only (multipart POSTs go straight
# to this URL). Set it when the Next.js host caps request bodies (Vercel
# serverless ≈4.5 MB) but the API is reachable on a same-site host, e.g. web on
# collegejunction.com and uploads → https://api.collegejunction.com — that keeps
# SameSite=Lax cookies flowing. Leave empty to upload through the proxy.
NEXT_PUBLIC_UPLOADS_URL=
