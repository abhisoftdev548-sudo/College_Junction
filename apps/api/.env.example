# ---- Server ----
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000
# Comma-separated extra origins (e.g. preview URLs)
EXTRA_CLIENT_ORIGINS=
TRUST_PROXY=false

# ---- Database ----
# Leave empty in development to use an in-memory MongoDB (data not persisted).
MONGODB_URI=

# ---- JWT (use long random strings; `openssl rand -hex 32`) ----
JWT_ACCESS_SECRET=change-me-access-secret-at-least-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-16-chars
JWT_EMAIL_SECRET=change-me-email-secret-at-least-16-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ---- Cookies ----
# Defaults: production → secure=true, SameSite=None; development → secure=false, SameSite=Lax.
# Override when testing cross-origin over HTTPS in non-production:
# COOKIE_SECURE=true
# COOKIE_DOMAIN=

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email (Nodemailer / SMTP). If SMTP_HOST is empty, emails are logged to console. ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="College Junction <no-reply@collegejunction.com>"

# Set to false to let unverified users post (dev only).
REQUIRE_EMAIL_VERIFICATION=true

# ---- Admin bootstrap (optional). Creates/promotes this admin at server start. ----
BOOTSTRAP_ADMIN=false
ADMIN_USERNAME=abhishek
ADMIN_EMAIL=abhisoftdev548@gmail.com
ADMIN_PASSWORD=Abhishek54321

# Dev/test only — never true in production (server refuses to start).
DISABLE_RATE_LIMIT=false
